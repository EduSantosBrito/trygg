  "note": "A and E are historical built checkpoints, H includes source and granular queue context fixes with a single service composition. Identical current fixture/runner in every snapshot. No server or external network. Not a dedicated host.",
  "runnerSource": "import hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport shutil\nimport subprocess\nimport tempfile\nimport time\n\nrepo = Path('/home/host/dev/trygg')\nroot = Path(tempfile.mkdtemp(prefix='trygg-granular-composed-', dir='/tmp/opencode'))\nsources = {\n    'a': Path('/tmp/trygg-row-granular-control-h0231t0s'),\n    'e': Path('/tmp/trygg-context-granular-dzxj_onr'),\n    'h': repo,\n}\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\nmetadata = {\n    'startedAt': time.time(), 'platform': platform.platform(),\n    'bun': subprocess.check_output(['bun', '--version'], text=True).strip(),\n    'root': str(root), 'transport': 'inline', 'snapshots': {}, 'runs': [],\n    'note': 'A and E are historical built checkpoints, H includes source and granular queue context fixes with a single service composition. Identical current fixture/runner in every snapshot. No server or external network. Not a dedicated host.',\n    'runnerSource': Path(__file__).read_text(),\n}\nfor label, source in sources.items():\n    clone = root / label\n    (clone / 'packages/core').mkdir(parents=True)\n    shutil.copytree(source / 'packages/core/dist', clone / 'packages/core/dist')\n    shutil.copytree(repo / 'scripts/benchmarks', clone / 'scripts/benchmarks')\n    shutil.copy2(repo / 'scripts/benchmark-browser.ts', clone / 'scripts/benchmark-browser.ts')\n    (clone / 'node_modules').symlink_to(repo / 'node_modules', target_is_directory=True)\n    (clone / 'packages/core/node_modules').symlink_to(repo / 'packages/core/node_modules', target_is_directory=True)\n    metadata['snapshots'][label] = {\n        'source': str(source),\n        'dist': {str(p.relative_to(clone)): sha(p) for p in sorted((clone / 'packages/core/dist').glob('*.js'))},\n        'sourceHashes': {name: sha(source / name) for name in [\n            'packages/core/src/primitives/render-keyed-list.ts',\n            'packages/core/src/primitives/renderer.ts',\n        ]},\n    }\n\nmetadata['harness'] = {str(p.relative_to(repo)): sha(p) for p in [\n    repo / 'scripts/benchmark-browser.ts', repo / 'scripts/benchmarks/browser.ts',\n    repo / 'scripts/benchmarks/mounts.ts', repo / 'scripts/benchmarks/memory.ts',\n]}\nenvironment_path = repo / 'docs/rfc/keyed-granular-composed-environment.json'\ndef run(label, name, probe=False, smoke=False):\n    output = repo / f'docs/rfc/keyed-granular-composed-{name}.json'\n    env = dict(os.environ, TMPDIR='/tmp/opencode', CHROME_BINARY='/tmp/trygg-chromium/bin/chromium',\n               BENCHMARK_INLINE='1', BENCHMARK_OUTPUT=str(output),\n               BENCHMARK_WARMUP='1' if probe or smoke else '20',\n               BENCHMARK_SAMPLES='3' if probe or smoke else '31')\n    if not smoke:\n        env.update(BENCHMARK_GRANULAR='1', BENCHMARK_CASE='update')\n    else:\n        env.update(BENCHMARK_MEMORY='1')\n    if probe:\n        env['BENCHMARK_WORK'] = '1'\n    start = time.time()\n    with (root / f'{name}.log').open('w') as log:\n        completed = subprocess.run(['bun', 'scripts/benchmark-browser.ts'], cwd=root / label,\n                                   env=env, stdout=log, stderr=subprocess.STDOUT, timeout=240)\n    evidence = {'label': label, 'name': name, 'probe': probe, 'smoke': smoke,\n                'exitCode': completed.returncode, 'seconds': time.time() - start}\n    if completed.returncode == 0:\n        evidence.update(artifact=str(output.relative_to(repo)), sha256=sha(output))\n    metadata['runs'].append(evidence)\n    environment_path.write_text(json.dumps(metadata, indent=2) + '\\n')\n    print(json.dumps(evidence), flush=True)\n    if completed.returncode != 0:\n        raise SystemExit((root / f'{name}.log').read_text())\n\nfor label, name in [('a','a1'), ('e','e1'), ('h','h1'), ('h','h2'), ('e','e2'), ('a','a2')]:\n    run(label, name)\nfor label in sources:\n    run(label, f'{label}-work', probe=True)\nrun('h', 'source-smoke-memory', smoke=True)\nmetadata['finishedAt'] = time.time()\nenvironment_path.write_text(json.dumps(metadata, indent=2) + '\\n')\n",
