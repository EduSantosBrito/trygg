  "command": "bun scripts/benchmark-browser.ts",
  "runnerSource": "import gzip\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nfrom datetime import datetime, timezone\n\nroot = Path('/home/host/dev/trygg')\npaths = [root / p for p in [\n    'packages/core/src/profiling.ts', 'packages/core/src/primitives/render-profiling.ts',\n    'packages/core/src/primitives/render-keyed-list.ts', 'scripts/benchmark-browser.ts',\n    'scripts/benchmarks/browser.ts', 'scripts/benchmarks/profiling.ts',\n    'scripts/benchmarks/profile-report.ts',\n]] + sorted((root / 'packages/core/dist').glob('*.js'))\nhashes = lambda: {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}\nbefore = hashes()\nreport = {'startedAt': datetime.now(timezone.utc).isoformat(), 'hashes': before,\n          'order': ['off1', 'paused1', 'record1', 'record2', 'paused2', 'off2'],\n          'runs': [], 'hostDedicated': False,\n          'transport': 'inline Chromium; in-memory OTLP capture; host collector POST after measurements',\n          'command': 'bun scripts/benchmark-browser.ts', 'runnerSource': Path(__file__).read_text()}\nfor name in report['order']:\n    mode = name[:-1]\n    out = Path('/tmp/opencode') / f'trygg-profile-{name}.json'\n    env = {**os.environ, 'TMPDIR': '/tmp/opencode', 'CHROME_BINARY': '/tmp/trygg-chromium/bin/chromium',\n           'BENCHMARK_INLINE': '1', 'BENCHMARK_GRANULAR': '1', 'BENCHMARK_CASE': 'update',\n           'BENCHMARK_WARMUP': '20', 'BENCHMARK_SAMPLES': '11', 'BENCHMARK_OTLP': mode,\n           'BENCHMARK_OUTPUT': str(out)}\n    if mode == 'record': env['BENCHMARK_OTLP_EXPORT'] = '1'\n    log = out.with_suffix('.log')\n    with log.open('w') as f:\n        subprocess.run(['bun', 'scripts/benchmark-browser.ts'], cwd=root, env=env, stdout=f, stderr=subprocess.STDOUT, check=True)\n    run = {'name': name, 'result': json.loads(out.read_text()), 'log': log.read_text()}\n    if mode != 'off':\n        raw = Path(str(out) + '.otlp.json')\n        otlp = json.loads(raw.read_text())\n        run['profiling'] = {k: v for k, v in otlp.items() if k not in ['batches', 'traceIds']}\n        run['profiling']['traceCount'] = len(otlp['traceIds'])\n        run['profiling']['firstTraceId'] = next(iter(otlp['traceIds']), None)\n        spans = [s for b in otlp['batches'] for r in json.loads(b)['resourceSpans'] for g in r['scopeSpans'] for s in g['spans']]\n        known = {s['spanId'] for s in spans}\n        run['profiling']['missingParentCount'] = sum(bool(s.get('parentSpanId')) and s['parentSpanId'] not in known for s in spans)\n        if mode == 'record':\n            assert len(spans) == 7700 and len(otlp['traceIds']) == 1100\n            assert run['profiling']['missingParentCount'] == 0\n            assert otlp['snapshot']['dropped'] == 0\n            dest = root / f'docs/rfc/profiling-{name}-otlp.json.gz'\n            dest.write_bytes(gzip.compress(raw.read_bytes(), mtime=0))\n            run['rawArtifact'] = str(dest.relative_to(root))\n            run['rawSha256'] = hashlib.sha256(raw.read_bytes()).hexdigest()\n            run['gzipSha256'] = hashlib.sha256(dest.read_bytes()).hexdigest()\n    report['runs'].append(run)\n    print(name, run['log'], flush=True)\nreport['hashesUnchanged'] = before == hashes()\nassert report['hashesUnchanged']\nreport['finishedAt'] = datetime.now(timezone.utc).isoformat()\n(root / 'docs/rfc/profiling-session-results.json').write_text(json.dumps(report, indent=2) + '\\n')\n",
