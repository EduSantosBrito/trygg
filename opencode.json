{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "effect/**",
      ".effect/**",
      ".trygg/**",
      "dist/**",
      "out/**",
      "*.db",
      "*.sqlite",
      "*.sqlite3",
      ".jj/**",
      ".git/**",
      "coverage/**"
    ]
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-pro": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 20000
  }
}
