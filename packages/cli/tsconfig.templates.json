{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "trygg",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "trygg": ["../core/src/index.ts"],
      "trygg/api": ["../core/src/api/types.ts"],
      "trygg/router": ["../core/src/router/index.ts"],
      "trygg/jsx-runtime": ["../core/src/jsx-runtime.ts"],
      "trygg/jsx-dev-runtime": ["../core/src/jsx-dev-runtime.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "floatingEffect": "suggestion"
        }
      }
    ]
  },
  "include": [
    "templates/**/*.ts",
    "templates/**/*.tsx",
    "templates/**/*.d.ts",
    "src/__tests__/incident-template.test.ts",
    "src/__tests__/incident-template-ui.test.tsx"
  ]
}
