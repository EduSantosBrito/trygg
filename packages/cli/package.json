{
  "name": "create-trygg",
  "version": "0.5.0-canary.3",
  "description": "Create a new trygg project",
  "keywords": [
    "create",
    "effect",
    "jsx",
    "template",
    "trygg",
    "ui"
  ],
  "homepage": "https://github.com/EduSantosBrito/trygg#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduSantosBrito/trygg.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-trygg": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "templates"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json",
    "test": "bun run --cwd ../core build && vitest run",
    "test:scaffold-smoke": "bun run --cwd ../core build && vitest run src/__tests__/scaffold.test.ts -t 'blank scaffold should typecheck and build successfully|incident scaffold should provide its global API client and build'"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "catalog:",
    "@types/node": "^20.0.0",
    "trygg": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "catalog:"
  }
}
