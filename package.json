{
  "name": "trygg-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/core build",
    "typecheck": "bun run --cwd packages/core typecheck",
    "typecheck:templates": "tsgo -p packages/cli/tsconfig.templates.json",
    "test": "bun run --cwd packages/core test && bun run --cwd apps/www test",
    "test:watch": "bun run --cwd packages/core test:watch",
    "examples": "bun run build && bun run --cwd apps/examples dev",
    "www": "bun run --cwd apps/www dev",
    "www:build": "bun run --cwd apps/www build",
    "www:preview": "bun run --cwd apps/www preview",
    "examples:preview": "bun run build && bun run --cwd apps/examples build && bun run --cwd apps/examples preview",
    "examples:install": "bun install --cwd apps/examples",
    "lint": "oxlint packages apps",
    "lint:fix": "oxlint packages apps --fix",
    "format": "oxfmt packages apps '!**/dist/**' --check",
    "format:fix": "oxfmt packages apps '!**/dist/**' --write",
    "effect:check": "bun run --cwd packages/core effect:check",
    "check": "bun run lint:fix && bun run format:fix && bun run typecheck && bun run effect:check",
    "readme:header": "bun run --cwd apps/www scripts/build-readme-header.mjs",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.58",
    "@effect/tsgo": "0.5.2",
    "@typescript/native-preview": "latest",
    "effect": "4.0.0-beta.58",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5.9.3"
  }
}
